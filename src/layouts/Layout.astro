---
import { buildPageMeta } from "@/seo";
import "@/styles/globals.css";

interface Props {
	title?: string;
	description?: string;
}

const { title = "Open MBOX", description = "Podgląd archiwum poczty .mbox w przeglądarce" } = Astro.props;

// Every link-preview tag comes from here. Adding one — a preview image, a locale —
// is an edit in src/seo/, and src/seo/index.test.ts fails if a tag name is written
// into this file instead.
const { canonical, tags } = buildPageMeta({
	title,
	description,
	site: Astro.site,
	url: Astro.url,
});
---

<!doctype html>
<html lang="pl">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical.href} />
		{tags.map((tag) => <meta {...tag} />)}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
