{
	"name": "open-mbox",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@12.6.0",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"prepare": "simple-git-hooks && wrangler types",
		"init-project": "tsx scripts/init-project.ts",
		"gen:llms-txt": "tsx scripts/generate-llms-txt.ts",
		"dev": "astro dev --port 3000",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"deploy:dev": "CLOUDFLARE_ENV=dev pnpm run build && wrangler deploy --env dev",
		"deploy:staging": "CLOUDFLARE_ENV=staging pnpm run build && wrangler deploy --env staging",
		"deploy:production": "CLOUDFLARE_ENV=production pnpm run build && wrangler deploy --env production",
		"cf-typegen": "wrangler types",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"types": "astro check && tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"lint:ci": "biome ci .",
		"knip": "knip",
		"release": "semantic-release",
		"release:dry": "semantic-release --dry-run"
	},
	"dependencies": {
		"@astrojs/cloudflare": "^14.4.0",
		"@astrojs/react": "^7.1.0",
		"@fontsource-variable/dm-sans": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"astro": "^7.4.0",
		"postal-mime": "^4.0.8",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tailwindcss": "^4.3.3",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@biomejs/biome": "^2.5.15",
		"@semantic-release/changelog": "^7.0.0",
		"@semantic-release/git": "^11.0.1",
		"@types/node": "^24.19.2",
		"@vitest/coverage-v8": "^5.0.5",
		"execa": "^10.2.0",
		"knip": "^6.41.0",
		"semantic-release": "^25.0.9",
		"simple-git-hooks": "^2.14.0",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"vitest": "^5.0.5",
		"wrangler": "^4.151.1",
		"yaml": "^2.9.1"
	},
	"simple-git-hooks": {
		"pre-commit": "pnpm run lint:ci",
		"pre-push": "pnpm run types && pnpm run knip"
	}
}
